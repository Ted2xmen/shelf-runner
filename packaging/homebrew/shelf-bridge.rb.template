# Cask for ted2xmen/homebrew-tap (Casks/shelf-bridge.rb). scripts/release.sh fills in
# @VERSION@ and @SHA256@; do not edit the generated copy by hand.
cask "shelf-bridge" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/ted2xmen/shelf-bridge/releases/download/v#{version}/ShelfBridge-#{version}.zip"
  name "shelf-bridge"
  desc "Runs Markdown queue lines as Claude Code or Codex jobs in tmux"
  homepage "https://github.com/ted2xmen/shelf-bridge"

  depends_on formula: "tmux"
  depends_on macos: :sonoma

  app "ShelfBridge.app"
  binary "#{appdir}/ShelfBridge.app/Contents/MacOS/shelf-bridge"

  # The LaunchAgent is the cask's job, not Bridge's (Bridge writes only its own folders).
  # Same content as launchd/dev.ted2xmen.shelf-bridge.plist.template in the source repo.
  # A block, not `postflight_steps`: the plist needs the absolute home path and launchctl needs the
  # user's uid, and install-step templates offer neither (Homebrew 7.0). The block is deprecated:
  # it warns on every install and fails to load under HOMEBREW_DEVELOPER.
  postflight do
    label = "dev.ted2xmen.shelf-bridge"
    plist = File.expand_path("~/Library/LaunchAgents/#{label}.plist")
    logs = File.expand_path("~/Library/Logs/shelf-bridge")
    FileUtils.mkdir_p [File.dirname(plist), logs]
    File.write plist, <<~XML
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0"><dict>
      <key>Label</key><string>#{label}</string>
      <key>AssociatedBundleIdentifiers</key><array><string>#{label}</string></array>
      <key>ProgramArguments</key><array>
        <string>#{appdir}/ShelfBridge.app/Contents/MacOS/shelf-bridge</string>
        <string>agent</string>
      </array>
      <key>RunAtLoad</key><true/>
      <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
      <key>ThrottleInterval</key><integer>30</integer>
      <key>ProcessType</key><string>Background</string>
      <key>StandardErrorPath</key><string>#{logs}/agent.log</string>
      <key>StandardOutPath</key><string>#{logs}/agent.log</string>
      </dict></plist>
    XML
    domain = "gui/#{Process.uid}"
    system_command "/bin/launchctl", args: ["bootout", "#{domain}/#{label}"], must_succeed: false
    # bootout returns before the old agent is gone; bootstrap fails with error 5 until it is.
    10.times do
      break if system_command("/bin/launchctl", args: ["bootstrap", domain, plist], must_succeed: false).success?

      sleep 0.5
    end
  end

  # `launchctl:` also removes ~/Library/LaunchAgents/<label>.plist; `delete:` would run rm via sudo.
  uninstall launchctl: "dev.ted2xmen.shelf-bridge"

  zap trash: [
    "~/.config/shelf-bridge",
    "~/Library/Application Support/shelf-bridge",
    "~/Library/Logs/shelf-bridge",
  ]

  caveats <<~EOS
    shelf-bridge starts at login (Login Items: ShelfBridge). Check the install with:
      shelf-bridge doctor
    Nothing runs until you enable a folder:
      shelf-bridge enable ~/path/to/folder
    Allow notifications for ShelfBridge: new queue lines ask for approval there.
  EOS
end
